"days":[
{"title":"Sol Duc to Deer Lake","desc":"Climb steadily through old-growth forest, past Canyon Creek, to Deer Lake.","from":0,"to":8.72,"stops":[[0,"Sol Duc trailhead","Start of the loop.","s"],[6.04,"Canyon Creek camp","Passed on the way up, at about 780 m.","c"],[8.72,"Deer Lake camp","Tonight's camp, at about 1,080 m.","e"]]},
{"title":"The High Divide to Heart Lake","desc":"Climb out of the basin to the High Divide and follow the ridge, with views of Mt. Olympus and the Bailey Range. Then take the shortest spur trail down to Heart Lake.","from":8.72,"to":19.09,"stops":[[8.72,"Deer Lake camp","Start of the day, about 1,080 m.","s"],[13.87,"Lunch Lake junction","Turn right here to drop into Seven Lakes Basin and Lunch Lake, a side trip of its own. Otherwise continue along the High Divide.","p"],[14.01,"Lunch Lake Campsite","A backup campsite in Seven Lakes Basin, about 0.6 km off the High Divide as the crow flies. Only if plans change.","c",47.91634,-123.78382],[15.18,"Bogachiel Peak spur","Short spur trail to the top of Bogachiel Peak.","p"],[17.5,"Mt. Olympus views","Stupendous views of Mt. Olympus from all along the High Divide Trail.","p"],[19.09,"Heart Lake Campsite","Tonight's camp, by Heart Lake. It sits on a spur trail about 0.6 km off the High Divide Trail.","e",47.9103,-123.73254]]},
{"title":"Appleton Pass to the Sol Duc River","desc":"Rejoin the High Divide Trail by the shortcut from Heart Lake and head east past Swimming Bear Lake to Spread Eagle Pass. Then turn back west over Appleton Pass and descend to the Appleton Pass Junction campsite, near the Sol Duc River Trail.","from":19.09,"to":31.59,"stops":[[19.09,"Heart Lake Campsite","Start of the day. A short connector trail leads back to the High Divide Trail.","s",47.9103,-123.73254],[20.37,"Bruce's Roost Junction","Trail junction on the way east. Keep following the route toward Swimming Bear Lake and Spread Eagle Pass.","p"],[21.96,"High Divide-Sol Duc Park Peak","Peak, 1,616 m. A possible short side trip, about 0.3 km each way along the dashed line on the map.","p",47.91104,-123.71891],[22.07,"Swimming Bear Lake","A lake right beside the trail, with water.","p"],[25.09,"Spread Eagle Pass","The far eastern point of the loop. The trail turns back west from here toward Appleton Pass.","p"],[27.35,"Appleton Pass","About 1,555 m, near Oyster Lake. Good place for a long break: water from Oyster Lake and Boulder Creek, no campfires.","p"],[31.59,"Appleton Pass JCT Campsite","Tonight's camp, at about 950 m, near where the Appleton Pass trail meets the Sol Duc River Trail.","e",47.93213,-123.75],[31.59,"Rocky Creek Campsite","Alternative camp, about 110 m further along the same short spur. The nearest mapped water is a stream about 0.2 km away, so check water before choosing it.","c",47.93196,-123.74868]]},
{"title":"Sol Duc Falls and out","desc":"Walk back down the short spur to the river trail, follow the river past the waterfall and Sol Duc Falls, then finish at the start.","from":31.59,"to":42.23,"stops":[[31.59,"Appleton Pass JCT Campsite","Start of the day, about 950 m.","s",47.93213,-123.75],[31.67,"Sol Duc River Trail junction","The Appleton Pass trail meets the main Sol Duc River Trail.","p"],[33.48,"Large waterfall","Large and scenic waterfall on the Sol Duc River.","p"],[34.21,"Sol Duc River Campsite","Campsite right on the river. Lots of campsites along the river here.","c"],[37.74,"Sol Duc Falls","The classic viewpoint, usually busy with day visitors.","p"],[38.9,"Sol Duc Falls trailhead","The road-end trailhead, at about 600 m.","p"],[42.23,"Sol Duc trailhead","Loop complete.","e"]]}
],
